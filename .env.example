# ============================================================
# .env.example — HoneyTrap
# Copiez ce fichier en .env et adaptez les valeurs
# JAMAIS commiter .env sur GitHub !
# ============================================================

# === Flask ===
FLASK_ENV=development
SECRET_KEY=change_me_in_production_use_a_long_random_string_here

# === PostgreSQL ===
POSTGRES_USER=honeytrap
POSTGRES_PASSWORD=strongpassword123
POSTGRES_DB=honeytrap
DATABASE_URL=postgresql://honeytrap:strongpassword123@honey-db:5432/honeytrap

# === Redis (Rate Limiting) ===
REDIS_URL=redis://honey-redis:6379/0

# === Paramètres Honeypot ===
BLOCK_THRESHOLD=10          # Bloquer une IP après N attaques
RATE_LIMIT=20 per minute    # Max 20 requêtes/min par IP
GEOIP_ENABLED=true          # Activer la géolocalisation ip-api.com
LOG_FILE=attacks.log        # Fichier de log JSON
